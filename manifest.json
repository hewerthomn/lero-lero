{
  "manifest_version": 3,
  "name": "Adicionar Lero-lero",
  "description": "Clique com o botão direito para adicionar textos de Lero-lero e dados simples de teste em campos de formulário.",
  "version": "1.1.0",
  "action": {
    "default_popup": "menu.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["messages/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
